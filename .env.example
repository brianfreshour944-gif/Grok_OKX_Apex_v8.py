# .env — Grok Alpaca Apex Bot configuration
# Copy this file and fill in your real values.
# Never commit the filled-in version to git (it's already in .gitignore).

# ── Alpaca API ─────────────────────────────────────────────────────────────────
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# Set to "true" for paper trading (safe/simulated), "false" for live money
APCA_API_PAPER=true

# ── Bot Identity ───────────────────────────────────────────────────────────────
BOT_NAME=Grok_Alpaca_Apex_v9_CuttingEdge

# ── Account Base (used for drawdown % calculations) ───────────────────────────
ACCOUNT_BASE=10000

# ── PostgreSQL (optional — leave blank to skip DB logging) ────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
