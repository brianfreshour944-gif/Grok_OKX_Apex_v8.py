# ==========================================================
# Grok Alpaca Apex Bot - Environment Configuration
# Copy this file to `.env` and fill in your real credentials.
# Never commit the filled-in version to git (it's already in .gitignore).
# ==========================================================

# --- Alpaca API credentials ---
APCA_API_KEY_ID=your_key_here
APCA_API_SECRET_KEY=your_secret_here

# Set to "true" for paper trading (safe/simulated), "false" for live money
APCA_API_PAPER=true

# --- Database (optional — leave unset to skip DB logging) ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Bot identity ---
BOT_NAME=Grok_Alpaca_Apex_v9_CuttingEdge
ACCOUNT_BASE=10000

# --- Diagnostics ---
# Set to DEBUG to see per-symbol signal values and rejection reasons every
# cycle. This is the #1 thing to flip if the bot looks "idle" with
# Positions: 0 and Value: $0.00 despite finding assets every cycle -- INFO
# level was silently swallowing exactly why each symbol failed the entry
# check (usually: signal never crosses BUY_SIGNAL threshold). Note: an
# always-visible INFO-level "📈 Signal: SYMBOL = X.XXXX" line was also added
# so you don't even need DEBUG to see the raw model output every cycle.
LOG_LEVEL=DEBUG

# --- Entry/exit signal thresholds ---
# The model's predict() returns a sigmoid output in [0, 1]. The ORIGINAL
# BUY_SIGNAL=0.62 is a HIGH bar. This is set to 0.51 (just above the neutral
# 0.5 coin-flip) as a TEMPORARY DIAGNOSTIC to prove the model is alive and
# generating a real statistical edge -- at 0.51 the bot fires on the
# slightest edge, so if trades still don't happen at this threshold, the
# problem is in feature_engineering.py / data pipeline, not the strategy
# threshold. Once you see the model's real signal values in the logs
# (📈 Signal: SYMBOL = X.XXXX), gradually raise this back up (0.55, 0.58,
# 0.62...) to find your real confidence/frequency sweet spot.
BUY_SIGNAL=0.51
SELL_SIGNAL=0.45
