# Prevent secrets and dev artifacts from being baked into the image
.env
*.env
.env.*

# Git metadata
.git
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Duplicate / backup model/scaler files (only the primary is needed)
*\ (2).*

# Dev/test scripts (not needed at runtime)
backtest_*.py
test_*.py
scratch_*.py
train_transformer.py
shadow_data_collector.py
check_scaler.py
test_ws.py
tests/
.pytest_cache/
requirements-dev.txt

# Standalone model-improvement pipeline worktree -- not imported by
# main_bot.py (the actual Docker CMD / live entry point) anywhere; verified
# via grep, zero references. Shipping it just bloats the image (~630KB).
audit_wt/

# Local IDE/editor files
.vscode/
.idea/
*.swp
